# COPIA ESTAS VARIABLES A TU .env PRIVADO. No reemplaces valores existentes sin revisarlos.
# BACKEND LOCAL: URL de tu PostgreSQL local con las migraciones 001 y 002 ejecutadas.
# RENDER: URL de la rama de pruebas de Neon (incluye sslmode=require).
DATABASE_URL=
PORT=3000

# Clave aleatoria de al menos 32 caracteres para firmar las sesiones de AutoPremium.
# Generar en terminal: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Pegar el resultado aquí y en Render. No compartirla ni publicarla.
AUTH_SECRET=

# Orígenes EXACTOS permitidos, separados por coma (página pública y administrador).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Activa true solo después de configurar las claves de PRUEBA.
MP_ENABLED=false
# Esta entrega bloquea producción. No cambiar a produccion para hacer pruebas.
MP_ENV=prueba
# Access Token de PRUEBA de tu aplicación nueva (generado automáticamente en Developers).
# En aplicaciones antiguas: APP_USR de un vendedor de prueba, nunca de tu cuenta real.
# El backend admite TEST- o una cuenta marcada test_user y verifica su ID/país antes de cobrar.
MP_ACCESS_TOKEN=
# ID del VENDEDOR DE PRUEBA asociado a ese Access Token (no el comprador).
MP_SELLER_ID=
# ID de tu aplicación AutoPremium CDMX - Sandbox.
MP_APPLICATION_ID=
# Correo fijo exigido por Orders para tarjetas de prueba. No requiere obtener el correo de la cuenta.
MP_TEST_BUYER_EMAIL=test@testuser.com
# Clave secreta de Webhooks de esa aplicación. No es el Access Token.
# URL a registrar en Developers: https://TU-BACKEND/api/mercadopago/webhook
# Evento: Order (Mercado Pago) / orders_v2. El backend verifica la firma.
MP_WEBHOOK_SECRET=
# Importe por vehículo en Sandbox, solicitado por el usuario.
# $10 permite un pago único con la Visa de prueba verificada; $1 devuelve empty_installments.
# Las órdenes existentes conservan su importe: cancelar el borrador y crear una nueva.
MP_TEST_UNIT_PRICE=10.00

# FRONTEND/Vercel: URL pública del backend o http://localhost:3000 al desarrollar.
VITE_API_URL=http://localhost:3000
# PUBLIC KEY correspondiente a esa misma aplicación/vendedor de prueba.
# Va en .env local y en Vercel (frontend público). Es pública; no confundir con Access Token.
VITE_MP_PUBLIC_KEY=
